<?xml version="1.0" encoding="UTF-8"?>
<Benchmark xmlns="http://checklists.nist.gov/xccdf/1.2" id="xccdf_org.example_benchmark_windows-server-2022" xml:lang="en">
  <status>draft</status>
  <title>Synthetic Windows Server 2022 Benchmark</title>
  <description>Invented rules for testing local profile imports. This fixture contains no CIS recommendations.</description>
  <version>1.7.3</version>
  <Profile id="xccdf_org.example_profile_L1_Member">
    <title>Level 1 - Member Server</title>
    <select idref="xccdf_org.example_rule_visibility" selected="true"/>
    <select idref="xccdf_org.example_rule_retired" selected="false"/>
    <select idref="xccdf_org.example_rule_embedded" selected="true"/>
  </Profile>
  <Profile id="xccdf_org.example_profile_L2_Member" extends="xccdf_org.example_profile_L1_Member">
    <title>Level 2 - Member Server</title>
    <select idref="xccdf_org.example_rule_archive" selected="true"/>
  </Profile>
  <Group id="xccdf_org.example_group_workshop">
    <title>Practice workshop</title>
    <Rule id="xccdf_org.example_rule_record" severity="low">
      <title>Record the workshop handover date</title>
      <description>Confirm the example handover sheet contains a date.</description>
    </Rule>
    <Rule id="xccdf_org.example_rule_visibility" selected="false" severity="medium">
      <title>Record whether the practice host's domain firewall profile is enabled</title>
      <description>The exercise records a boolean value for its demonstration host.</description>
    </Rule>
    <Rule id="xccdf_org.example_rule_archive" selected="false" severity="low">
      <title>Archive the practice worksheet</title>
      <description>Ask the exercise facilitator for the archived worksheet.</description>
    </Rule>
    <Rule id="xccdf_org.example_rule_retired" severity="low">
      <title>Retired workshop task</title>
    </Rule>
  </Group>
  <Group id="xccdf_org.example_group_optional" selected="false">
    <title>Closed workshop</title>
    <Rule id="xccdf_org.example_rule_embedded" severity="info">
      <title>Optional task inside the closed workshop</title>
    </Rule>
  </Group>
</Benchmark>
